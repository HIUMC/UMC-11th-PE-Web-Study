{
  "info": {
    "name": "UMC 8주차 백엔드 - 즐겨찾기와 영화 기록",
    "description": "01부터 30까지 순서대로 실행. 01에서 실습용 회원 정보를 새로 생성하며, 로그인 토큰은 컬렉션 변수에 저장. 기본 서버: http://localhost:8088. 요청/응답은 실제 실행 후 캡처.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8088",
      "type": "string"
    },
    {
      "key": "emailA",
      "value": "",
      "type": "string"
    },
    {
      "key": "emailB",
      "value": "",
      "type": "string"
    },
    {
      "key": "nicknameA",
      "value": "",
      "type": "string"
    },
    {
      "key": "nicknameB",
      "value": "",
      "type": "string"
    },
    {
      "key": "memberIdA",
      "value": "",
      "type": "string"
    },
    {
      "key": "memberIdB",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessTokenA",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessTokenB",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 회원가입 A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"nickname\": \"{{nicknameA}}\",\n  \"password\": \"Umc!1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString(36) + Math.random().toString(36).slice(2, 5);",
              "for (const key of [\"accessTokenA\", \"accessTokenB\", \"memberIdA\", \"memberIdB\"]) pm.collectionVariables.unset(key);",
              "pm.collectionVariables.set(\"emailA\", \"week8-a-\" + runId + \"@umc.test\");",
              "pm.collectionVariables.set(\"emailB\", \"week8-b-\" + runId + \"@umc.test\");",
              "pm.collectionVariables.set(\"nicknameA\", \"가\" + runId.slice(-10));",
              "pm.collectionVariables.set(\"nicknameB\", \"나\" + runId.slice(-10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"공통 응답 코드\", () => { pm.expect(body.code).to.eql(\"COMMON201\"); pm.expect(body.isSuccess).to.eql(true); });",
              "pm.collectionVariables.set(\"memberIdA\", String(body.result.memberId));"
            ]
          }
        }
      ]
    },
