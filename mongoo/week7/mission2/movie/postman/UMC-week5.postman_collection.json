{
  "info": {
    "name": "UMC Backend Week 5 · Spring Boot",
    "description": "기본 시드 기준. memberId를 실제 수현 회원 ID로 변경하세요. 신규 값은 DB에 없어야 합니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "memberId",
      "value": "1"
    },
    {
      "key": "missingMemberId",
      "value": "999999999"
    }
  ],
  "item": [
    {
      "name": "닉네임 중복",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/nickname/%EC%88%98%ED%98%84"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"available\", () => pm.expect(pm.response.json().available).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "닉네임 신규",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/nickname/umc-new-member-2026"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"available\", () => pm.expect(pm.response.json().available).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "이메일 중복",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/email/noco@umc.com"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"available\", () => pm.expect(pm.response.json().available).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "이메일 신규",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/email/umc-new-2026@example.com"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"available\", () => pm.expect(pm.response.json().available).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "회원별 평점 (기본 시드 2건)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const ratings = pm.response.json();",
              "pm.test(\"수현 시드 평점 2건\", () => pm.expect(ratings).to.have.lengthOf(2));",
              "pm.test(\"최신 등록순\", () => { for(let i=1; i<ratings.length; i++) pm.expect(ratings[i-1].ratingId).to.be.above(ratings[i].ratingId); });",
              "pm.test(\"DTO 필드\", () => { ratings.forEach(r => pm.expect(r).to.have.all.keys(\"ratingId\", \"movieId\", \"score\", \"comment\", \"createdAt\", \"updatedAt\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "없는 회원 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/{{missingMemberId}}/ratings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "숫자가 아닌 회원 번호 400",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/abc/ratings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
