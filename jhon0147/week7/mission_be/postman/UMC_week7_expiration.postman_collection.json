{
  "info": {
    "name": "UMC 7주차 선택 · 60초 토큰 만료",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8087"
    },
    {
      "key": "shortRun",
      "value": ""
    },
    {
      "key": "shortToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 · 만료 확인용 회원가입",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"expiry{{shortRun}}@umc.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"만료{{shortRun}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"shortRun\", String(Date.now()).slice(-7));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"공통 응답 형식\", () => { pm.expect(body).to.have.keys(\"isSuccess\", \"code\", \"message\", \"result\"); pm.expect(body.isSuccess).to.eql(true); });",
              "pm.test(\"응답 코드 COMMON201\", () => pm.expect(body.code).to.eql(\"COMMON201\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · 60초 토큰 발급",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"expiry{{shortRun}}@umc.com\",\n  \"password\": \"Umc!1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"공통 응답 형식\", () => { pm.expect(body).to.have.keys(\"isSuccess\", \"code\", \"message\", \"result\"); pm.expect(body.isSuccess).to.eql(true); });",
              "pm.test(\"응답 코드 COMMON200\", () => pm.expect(body.code).to.eql(\"COMMON200\"));",
              "pm.collectionVariables.set(\"shortToken\", body.result.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 · 만료 전 내 정보 조회",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{shortToken}}"
          }
        ],
        "url": "{{baseUrl}}/members/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"공통 응답 형식\", () => { pm.expect(body).to.have.keys(\"isSuccess\", \"code\", \"message\", \"result\"); pm.expect(body.isSuccess).to.eql(true); });",
              "pm.test(\"응답 코드 COMMON200\", () => pm.expect(body.code).to.eql(\"COMMON200\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 · 발급 후 61초 지난 뒤 전송",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{shortToken}}"
          }
        ],
        "url": "{{baseUrl}}/members/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "const body = pm.response.json();",
              "pm.test(\"공통 응답 형식\", () => { pm.expect(body).to.have.keys(\"isSuccess\", \"code\", \"message\", \"result\"); pm.expect(body.isSuccess).to.eql(false); });",
              "pm.test(\"응답 코드 AUTH401_4\", () => pm.expect(body.code).to.eql(\"AUTH401_4\"));"
            ]
          }
        }
      ]
    }
  ]
}
