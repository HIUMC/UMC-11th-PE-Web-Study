            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"공통 응답 형식\", () => { pm.expect(body).to.have.keys(\"isSuccess\", \"code\", \"message\", \"result\"); pm.expect(body.isSuccess).to.eql(true); });",
              "pm.test(\"응답 코드 COMMON200\", () => pm.expect(body.code).to.eql(\"COMMON200\"));",
              "pm.collectionVariables.set(\"tokenA\", body.result.accessToken);",
              "pm.test(\"Access Token 발급\", () => pm.expect(body.result.accessToken.split(\".\")).to.have.lengthOf(3));",
              "pm.test(\"비밀번호 미포함\", () => pm.expect(body.result).not.to.have.property(\"password\"));"
            ]
          }
        }
      ]
