{
  "info": {
    "name": "UMC Week4 - Books (JPA)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:8080" }],
  "item": [
    {
      "name": "1. GET /books (성공)",
      "request": { "method": "GET", "url": "{{baseUrl}}/books" }
    },
    {
      "name": "2. POST /books (성공 201)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/books",
        "body": { "mode": "raw", "raw": "{\n  \"categoryId\": 2,\n  \"title\": \"ORM 입문\",\n  \"description\": \"JPA 실습\"\n}" }
      }
    },
    {
      "name": "3. POST /books (없는 카테고리 404)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/books",
        "body": { "mode": "raw", "raw": "{\n  \"categoryId\": 999,\n  \"title\": \"없는 카테고리\"\n}" }
      }
    },
    {
      "name": "4. POST /books (빈 제목 400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/books",
        "body": { "mode": "raw", "raw": "{\n  \"categoryId\": 1,\n  \"title\": \"  \"\n}" }
      }
    }
  ]
}
