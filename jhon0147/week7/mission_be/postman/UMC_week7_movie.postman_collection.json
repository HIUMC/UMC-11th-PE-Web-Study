    {
      "name": "5. A 평점 등록",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": "{{baseUrl}}/ratings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 550,\n  \"score\": 5,\n  \"comment\": \"다시 보고 싶은 영화\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"공통 응답 형식\", () => { pm.expect(body).to.have.keys(\"isSuccess\", \"code\", \"message\", \"result\"); pm.expect(body.isSuccess).to.eql(true); });",
              "pm.test(\"응답 코드 COMMON201\", () => pm.expect(body.code).to.eql(\"COMMON201\"));",
              "pm.collectionVariables.set(\"ratingId\", body.result.ratingId);",
              "pm.test(\"등록 결과\", () => { pm.expect(body.result.movieId).to.eql(550); pm.expect(body.result.score).to.eql(5); });",
              "pm.test(\"요청 바디에 memberId 없음\", () => pm.expect(JSON.parse(pm.request.body.raw)).not.to.have.property(\"memberId\"));"
            ]
          }
        }
      ]
    },
