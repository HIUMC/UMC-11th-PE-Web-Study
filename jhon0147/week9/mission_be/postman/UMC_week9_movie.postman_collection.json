    {
      "name": "05 OpenAPI 문서는 토큰 없이 조회",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/v3/api-docs"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const doc = pm.response.json();",
              "pm.test(\"보호 API 자물쇠\", () => pm.expect(doc.paths[\"/favorites\"].post.security[0]).to.have.property(\"bearerAuth\"));",
              "pm.test(\"공개 로그인\", () => pm.expect(doc.paths[\"/auth/login\"].post.security || []).to.have.lengthOf(0));"
            ]
          }
        }
      ]
    },
