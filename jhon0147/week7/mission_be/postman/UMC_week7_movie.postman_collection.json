              "pm.collectionVariables.set(\"memberIdB\", body.result.memberId);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. 로그인 성공 A ",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
