{
  "info": {
    "name": "UMC 6주차 영화 평점 API",
    "description": "Collection Runner에서 위에서 아래로 실행합니다. 첫 요청이 실습용 이메일과 닉네임을 새로 만들며 생성된 회원·평점 번호를 다음 요청에 사용합니다. 실습용 비밀번호는 Umc!1234입니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 회원가입",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"{{nickname}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const stamp = String(Date.now());",
              "pm.collectionVariables.set(\"email\", \"movie-\" + stamp + \"@umc.com\");",
              "pm.collectionVariables.set(\"nickname\", \"영화\" + stamp.slice(-8));",
              "pm.collectionVariables.set(\"otherEmail\", \"other-\" + stamp + \"@umc.com\");",
              "pm.collectionVariables.set(\"otherNickname\", \"다른\" + stamp.slice(-8));",
              "pm.collectionVariables.set(\"unusedEmail\", \"unused-\" + stamp + \"@umc.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"공통 응답\", () => pm.expect(body.isSuccess).to.eql(true));",
              "pm.test(\"응답 코드\", () => pm.expect(body.code).to.eql(\"COMMON201\"));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"memberId\", String(body.result.memberId));"
            ]
          }
        }
      ]
    },
