{
  "info": {
    "name": "UMC 7주차",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8087"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "suffix",
      "value": ""
    },
    {
      "key": "tokenA",
      "value": ""
    },
    {
      "key": "tokenB",
      "value": ""
    },
    {
      "key": "memberIdA",
      "value": ""
    },
    {
      "key": "memberIdB",
      "value": ""
    },
    {
      "key": "ratingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. 회원 A 가입",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"a{{runId}}@umc.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"가{{suffix}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = String(Date.now());",
              "pm.collectionVariables.set(\"runId\", runId);",
              "pm.collectionVariables.set(\"suffix\", runId.slice(-7));",
              "[\"tokenA\",\"tokenB\",\"ratingId\",\"memberIdA\",\"memberIdB\",\"loginFailure\"].forEach(key => pm.collectionVariables.unset(key));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"공통 응답 형식\", () => { pm.expect(body).to.have.keys(\"isSuccess\", \"code\", \"message\", \"result\"); pm.expect(body.isSuccess).to.eql(true); });",
              "pm.test(\"응답 코드 COMMON201\", () => pm.expect(body.code).to.eql(\"COMMON201\"));",
              "pm.collectionVariables.set(\"memberIdA\", body.result.memberId);",
              "pm.test(\"비밀번호 미포함\", () => pm.expect(body.result).not.to.have.property(\"password\"));"
            ]
          }
        }
      ]
    },
